<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Chuỗi kết nối đến cơ sở dữ liệu QLChoThueSach. Bạn có thể thay đổi Data Source (tên máy / server) tại đây -->
    <add name="QLChoThueSach"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QLChoThueSach;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>

